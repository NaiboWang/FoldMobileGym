# Copy to foldagent/.env; supply your own key. Never commit foldagent/.env.
OPENAI_API_KEY=replace_with_your_api_key
# Example model; replace with a vision + Structured Outputs model your account supports.
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1
# responses (default), or chat-completions for a compatible provider.
FOLDAGENT_API=responses
# Optional executable paths, without surrounding quotes. Relative paths resolve
# from the foldmobilegym repository root when commands are run as documented:
# FOLDAGENT_BROWSER_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# Windows: FOLDAGENT_PYTHON_PATH=.venv/Scripts/python.exe
# macOS/Linux: FOLDAGENT_PYTHON_PATH=.venv/bin/python

