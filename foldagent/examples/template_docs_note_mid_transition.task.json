  "instruction": "打开“项目评审通知”，读取日期、时间和会议室，随后点击页面底部的“完成阅读”；在微信“Boss”会话中保存且仅保存一条草稿，内容严格为“项目评审：<日期> <时间>，<会议室>。”。尖括号字段替换为文档原文，日期与时间之间仅一个空格，不添加其他标点。不要发送。",
  "initial_state": "tasks/seeds/J97.json",
  "initial_window": {
    "posture": "unfolded",
    "layout": "inner_wide",
    "focused_app": "workspace_docs",
    "mode": "fullscreen"
  },
  "apps": [
    "workspace_docs",
    "wechat"
  ],
  "seed_contract": {
    "fixture": "a01_notice_v1",
    "document_id": "project_review_notice",
    "target_thread_id": "wxid_boss_007",
    "distractors": [
      "项目复盘通知",
      "产品伙伴"
    ]
  },
  "event_plan": [
    {
