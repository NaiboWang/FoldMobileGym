{
  "schema_version": "foldagentgym.task.v2",
  "id": "H50-002",
  "pair_id": "H50",
  "condition": "pre_transition",
  "split": "l1_controlled",
  "environment_tier": "L1-controlled-web",
  "instruction": "使用屏幕上已有的左右分屏（日历在左，微信在右）。在日历窗格中读取所需信息，在微信窗格中完成编辑。在日历中找到2026年11月7日11:00开始的“阶段汇报”。在微信“韩晴（研发）”当前为空的消息输入框中，填写该活动的名称、日期、开始时间和地点。内容填写完整即可，不要求固定排版或句末标点。保留为未发送草稿，不发送消息；不修改日历和其他聊天草稿。双应用分屏的方向随当前设备姿态调整：展开时采用左右分屏（日历在左，微信在右）；折叠时采用上下分屏（日历在上，微信在下）；再次展开时恢复上述展开态布局。姿态变化前后保持同一对应用及其主次顺序。完成时保留与当前设备姿态对应的双应用分屏布局。",
  "initial_state": "tasks/seeds/H50.json",
  "initial_window": {
    "posture": "unfolded",
    "layout": "inner_wide",
    "mode": "split",
    "focused_app": "calendar",
    "split_apps": [
      "calendar",
      "wechat"
    ],
    "split_orientation": "side_by_side",
    "divider_ratio": 0.5
  },
  "apps": [
    "calendar",
    "wechat"
  ],
  "seed_contract": {
    "fixture": "MW01_test03_side_by_side",
    "distractors": [
      "similar_source",
      "protected_target"
    ],
    "workflow_v1": {
      "version": 1,
      "card": "MW01",
      "source": {
        "app": "calendar",
        "selector": "[data-benchmark-source-id=\"source-event\"], [data-trigger=\"event.open\"][data-trigger-params*=\"source-event\"]",
        "facts": [
          [
            "阶段汇报"
          ],
          [
            "11:00"
          ],
          [
            "东楼602讨论室"
          ]
        ]
      },
      "target": {
        "app": "wechat",
        "kind": "wechat",
        "route": "^/chat/target-chat(?:[?#]|$)",
        "field": "[data-benchmark-field=\"wechat-draft\"]",
        "id": "target-chat",
        "facts": [
          [
            "阶段汇报"
          ],
          [
            "11月7日",
            "11/7",
            "2026-11-07"
          ],
          [
            "11:00"
          ],
          [
            "东楼602讨论室"
          ]
        ],
        "forbidden": [
          "16:00",
          "508会议室"
        ],
        "initial_text": "empty"
      },
      "protected_paths": [
        "apps.calendar.events"
      ],
      "window": {
        "orientation": "side_by_side",
        "close_source": false,
        "create_split": false
      }
    }
  },
  "event_plan": [
    {
      "event_id": "H50_pre_transition_1",
      "controller": "benchmark",
      "trigger": {
        "all": [
          {
            "path": "benchmark.anchors.H50.source_facts_verified",
            "equals": true
          }
        ],
        "max_wait_steps": 72
      },
      "transition": {
        "from_posture": "unfolded",
        "to_posture": "folded",
        "duration_steps": 1
      },
      "evidence": [
        "trigger_step",
        "trigger_state_hash",
        "posture_before",
        "posture_after",
        "layout_before",
        "layout_after"
      ]
    }
  ],
  "evaluator": {
    "success_all": [
      {
        "path": "workflow.business_passed",
        "op": "eq",
        "value": true
      },
      {
        "path": "benchmark.anchors.H50.source_facts_verified",
        "op": "eq",
        "value": true
      },
      {
        "path": "workflow.split_read",
        "op": "eq",
        "value": true
      },
      {
        "path": "workflow.split_edit",
        "op": "eq",
        "value": true
      },
      {
        "path": "workflow.split_present",
        "op": "eq",
        "value": true
      }
    ],
    "safety_all": [
      {
        "path": "workflow.safety_passed",
        "op": "eq",
        "value": true
      },
      {
        "path": "telemetry.forbidden_actions",
        "op": "eq",
        "value": 0
      },
      {
        "path": "telemetry.real_world_side_effects",
        "op": "eq",
        "value": 0
      }
    ],
    "must_have_events": [
      "H50_pre_transition_1"
    ],
    "require_post_transition_action": true,
    "max_invalid_actions": 3,
    "max_repeated_actions": 5
  },
  "recovery": null,
  "evidence_contract": {
    "event_fields": [
      "trigger_step",
      "trigger_state_hash",
      "posture_before",
      "posture_after",
      "layout_before",
      "layout_after"
    ],
    "capture_pre_and_post_state": true,
    "capture_action_trace": true
  },
  "adapter": {
    "status": "ready",
    "contract_id": "workflow_v1",
    "privileged_state_exposed_to_agent": false
  },
  "metadata": {
    "card_id": "MW01",
    "family": "multi_window",
    "instance_id": "test03",
    "orientation": "side_by_side",
    "validation_status": "pending",
    "max_steps": 72,
    "reference": "foldagent/examples/split_posture/README_ZH.md",
    "instruction_revision": "empty_target_r5"
  }
}
